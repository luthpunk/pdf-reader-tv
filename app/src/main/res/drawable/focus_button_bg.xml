<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused: Clean White Outline -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/pill_bg_focused" />
            <stroke android:width="1.2dp" android:color="@color/pill_stroke_focused" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#2E3444" />
            <stroke android:width="1.2dp" android:color="@color/pill_stroke_focused" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <!-- Unfocused: Transparent Pill Outlined without color -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pill_bg_normal" />
            <stroke android:width="1dp" android:color="@color/pill_stroke_normal" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
