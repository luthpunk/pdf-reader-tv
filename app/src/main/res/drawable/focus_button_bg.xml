<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused: Solid White Pill, Text & Icon will turn #121317 (Black) for crystal-clear readability -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <stroke android:width="1.2dp" android:color="#FFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#E4E7EC" />
            <stroke android:width="1.2dp" android:color="#E4E7EC" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <!-- Unfocused: Transparent Pill Outlined without color fill -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="#484E5E" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
