<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused: Thin 1.2dp Pure White Outline, Square (radius 2dp) -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_card_focused" />
            <stroke android:width="1.2dp" android:color="#FFFFFF" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <!-- Unfocused: Thin 1dp Subtle Outline, Square (radius 2dp) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_card" />
            <stroke android:width="1dp" android:color="@color/border_subtle" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</selector>
