<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main"
    android:paddingStart="40dp"
    android:paddingEnd="40dp"
    android:paddingTop="22dp"
    android:paddingBottom="22dp">

    <!-- Header: Title and Close -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tvPickerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Browse Documents"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPickerClose"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="Close"
            android:textColor="@color/btn_focus_text_color"
            android:textSize="12sp"
            android:textStyle="bold"
            android:drawableStart="@drawable/ic_close_stroke"
            android:drawablePadding="5dp"
            android:background="@drawable/focus_button_bg"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:focusable="true" />
    </LinearLayout>

    <!-- Quick Location Shortcuts with Line Icons (Smaller 34dp buttons) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btnShortcutDownload"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="Download"
            android:textColor="@color/btn_focus_text_color"
            android:textSize="12sp"
            android:textStyle="bold"
            android:drawableStart="@drawable/ic_folder_stroke"
            android:drawablePadding="5dp"
            android:background="@drawable/focus_button_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:focusable="true"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnShortcutDocuments"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="Documents"
            android:textColor="@color/btn_focus_text_color"
            android:textSize="12sp"
            android:textStyle="bold"
            android:drawableStart="@drawable/ic_pdf_stroke"
            android:drawablePadding="5dp"
            android:background="@drawable/focus_button_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:focusable="true"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnShortcutUsb"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="USB Drives"
            android:textColor="@color/btn_focus_text_color"
            android:textSize="12sp"
            android:textStyle="bold"
            android:drawableStart="@drawable/ic_folder_stroke"
            android:drawablePadding="5dp"
            android:background="@drawable/focus_button_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:focusable="true"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnShortcutScanAll"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="Scan All"
            android:textColor="@color/btn_focus_text_color"
            android:textSize="12sp"
            android:textStyle="bold"
            android:drawableStart="@drawable/ic_search_stroke"
            android:drawablePadding="5dp"
            android:background="@drawable/focus_button_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:focusable="true"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnShortcutSystemPicker"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="System Picker"
            android:textColor="@color/btn_focus_text_color"
            android:textSize="12sp"
            android:textStyle="bold"
            android:drawableStart="@drawable/ic_folder_stroke"
            android:drawablePadding="5dp"
            android:background="@drawable/focus_button_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:focusable="true" />
    </LinearLayout>

    <!-- Current Path Breadcrumb in White -->
    <TextView
        android:id="@+id/tvCurrentPath"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="/storage/emulated/0"
        android:textColor="#FFFFFF"
        android:textSize="12.5sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="start"
        android:layout_marginBottom="10dp" />

    <!-- File list container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFileList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="vertical"
            android:scrollbarThumbVertical="@color/neon_cyan" />

        <LinearLayout
            android:id="@+id/layoutEmptyFolder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_folder_stroke"
                android:layout_marginBottom="8dp"
                android:contentDescription="Empty" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No PDF files found in this folder."
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Try clicking [Download], [Documents], or [Scan All] above."
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pbScanning"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/neon_cyan"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
