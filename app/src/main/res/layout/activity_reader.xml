<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/readerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:focusable="true">

    <!-- Paged View: ViewPager2 with Pre-rendered Buffers for Flicker-Free Slide Transitions -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vpReaderPaged"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal" />

    <!-- Loading Indicator -->
    <ProgressBar
        android:id="@+id/docLoadingIndicator"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/neon_cyan"
        android:visibility="gone" />

    <!-- 1. Floating Top Toolbar (Focus Mode toggles visibility) -->
    <LinearLayout
        android:id="@+id/topToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@color/overlay_toolbar"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="← Back"
            android:textColor="@color/btn_focus_text_color"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/focus_button_bg"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:focusable="true"
            android:layout_marginEnd="20dp" />

        <TextView
            android:id="@+id/tvDocTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Document Title"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Bookmark Toggle Button -->
        <Button
            android:id="@+id/btnToggleBookmark"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="★ Bookmark"
            android:textColor="@color/btn_focus_text_color"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/focus_button_bg"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:focusable="true"
            android:layout_marginEnd="14dp" />

        <!-- Side Drawer / TOC Button -->
        <Button
            android:id="@+id/btnOpenToc"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="☰ TOC / Pages"
            android:textColor="@color/btn_focus_text_color"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/focus_button_bg"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:focusable="true" />
    </LinearLayout>

    <!-- 2. Floating Bottom Bar (Page Number, Progress, Remote Guide) -->
    <LinearLayout
        android:id="@+id/bottomToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/overlay_toolbar"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvPageIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Page 1 of 1"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvRemoteTip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[OK] Toggle Menu  •  [◀ / ▶] Previous / Next Page  •  [▲] Navigate to Toolbar"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/readerProgressBar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progressBackgroundTint="@color/progress_track"
            android:progressTint="@color/neon_cyan" />
    </LinearLayout>

    <!-- 3. Side Drawer Overlay (Table of Contents & Bookmarks) -->
    <LinearLayout
        android:id="@+id/drawerLayout"
        android:layout_width="380dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/overlay_drawer"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone"
        android:elevation="16dp"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/toc"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCloseDrawer"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="✕ Close"
                android:textColor="@color/btn_focus_text_color"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/focus_button_bg"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:focusable="true" />
        </LinearLayout>

        <!-- Bookmarks Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bookmarks"
            android:textColor="@color/accent_amber"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:layout_marginBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvBookmarks"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginBottom="16dp"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/tvNoBookmarks"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="@string/no_bookmarks"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:gravity="center"
            android:visibility="gone" />

        <!-- Jump to Page Navigation -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PAGES / SECTIONS"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:layout_marginBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPageList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="vertical" />
    </LinearLayout>

</FrameLayout>
