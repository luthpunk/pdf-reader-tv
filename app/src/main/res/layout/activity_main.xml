<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main"
    android:paddingStart="44dp"
    android:paddingEnd="44dp"
    android:paddingTop="22dp"
    android:paddingBottom="20dp">

    <!-- Top Bar: Brand + Clean Outlined Pill Buttons (Search and Browse Files) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="18dp">

        <!-- Brand Title -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="TV Reader"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.02" />

        <!-- Top Menu: Only Search and Browse Files (Pill Outlined, Transparent) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSearch"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="Search"
                android:textColor="@color/btn_focus_text_color"
                android:textSize="12sp"
                android:textStyle="bold"
                android:drawableStart="@drawable/ic_search_stroke"
                android:drawablePadding="6dp"
                android:background="@drawable/focus_button_bg"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:focusable="true"
                android:nextFocusRight="@+id/btnBrowseFiles"
                android:layout_marginEnd="12dp" />

            <Button
                android:id="@+id/btnBrowseFiles"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="Browse Files"
                android:textColor="@color/btn_focus_text_color"
                android:textSize="12sp"
                android:textStyle="bold"
                android:drawableStart="@drawable/ic_folder_stroke"
                android:drawablePadding="6dp"
                android:background="@drawable/focus_button_bg"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:focusable="true"
                android:nextFocusLeft="@+id/btnSearch" />
        </LinearLayout>
    </LinearLayout>

    <!-- Search Input Bar with Line Icons -->
    <LinearLayout
        android:id="@+id/layoutSearchBar"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="@drawable/focus_button_bg"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:layout_marginBottom="14dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_search_stroke"
            android:layout_marginEnd="10dp"
            android:contentDescription="Search Icon" />

        <EditText
            android:id="@+id/etSearchQuery"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:hint="Type document title..."
            android:textColorHint="@color/text_muted"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:background="@null"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLines="1" />

        <Button
            android:id="@+id/btnClearSearch"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="Clear"
            android:textColor="@color/btn_focus_text_color"
            android:textSize="11sp"
            android:textStyle="bold"
            android:drawableStart="@drawable/ic_close_stroke"
            android:drawablePadding="4dp"
            android:background="@drawable/focus_button_bg"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:focusable="true" />
    </LinearLayout>

    <!-- Main Content Swimlanes -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/mainScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ROW 1: CONTINUE READING -->
            <LinearLayout
                android:id="@+id/layoutContinueReading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="22dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CONTINUE READING"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="10dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvContinueReading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:clipToPadding="false"
                    android:scrollbars="none" />
            </LinearLayout>

            <!-- ROW 2: ALL DOCUMENTS -->
            <LinearLayout
                android:id="@+id/layoutAllDocuments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ALL DOCUMENTS"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06" />

                    <TextView
                        android:id="@+id/tvTotalDocumentsCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="(0 files)"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvAllDocuments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:clipToPadding="false"
                    android:scrollbars="none" />

                <!-- Empty State -->
                <LinearLayout
                    android:id="@+id/layoutEmptyState"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_pdf_stroke"
                        android:layout_marginBottom="8dp"
                        android:contentDescription="No PDF" />

                    <TextView
                        android:id="@+id/tvEmptyMessage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No PDF documents found on this TV."
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Click Browse Files to locate PDFs or plug in a USB flash drive."
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
