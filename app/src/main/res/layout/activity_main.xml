<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main"
    android:paddingStart="40dp"
    android:paddingEnd="40dp"
    android:paddingTop="28dp"
    android:paddingBottom="28dp">

    <!-- Top Bar: App Title and Exactly 2 Prominent Navigation Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold"
                android:letterSpacing="0.02" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tagline"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- The 2 Top Buttons requested: [Browse Files] and [Library] -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnBrowseFiles"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:text="📁 Browse Files"
                android:textColor="@color/btn_focus_text_color"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/focus_button_bg"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:focusable="true"
                android:nextFocusDown="@+id/heroCard"
                android:nextFocusRight="@+id/btnLibrary"
                android:layout_marginEnd="16dp" />

            <Button
                android:id="@+id/btnLibrary"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:text="📚 Library"
                android:textColor="@color/btn_focus_text_color"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/focus_button_bg"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:focusable="true"
                android:nextFocusDown="@+id/heroCard"
                android:nextFocusLeft="@+id/btnBrowseFiles" />
        </LinearLayout>
    </LinearLayout>

    <!-- Main Content Area: Left side Continue Reading, Right side Recent Books -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- 1. Continue Reading (Hero Card) -->
        <LinearLayout
            android:layout_width="320dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_marginEnd="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/continue_reading"
                android:textColor="@color/accent_blue"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.05"
                android:layout_marginBottom="10dp" />

            <FrameLayout
                android:id="@+id/heroCard"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/focus_card_bg"
                android:padding="16dp"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusUp="@+id/btnBrowseFiles"
                android:nextFocusRight="@+id/rvRecentBooks">

                <LinearLayout
                    android:id="@+id/heroContent"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <!-- Hero Cover Thumbnail -->
                    <ImageView
                        android:id="@+id/heroCover"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:scaleType="fitCenter"
                        android:background="#0A0D14"
                        android:contentDescription="Book Cover" />

                    <!-- Book Title -->
                    <TextView
                        android:id="@+id/heroTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Book Title"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:layout_marginTop="12dp" />

                    <!-- Progress Bar -->
                    <ProgressBar
                        android:id="@+id/heroProgressBar"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="8dp"
                        android:max="100"
                        android:progress="45"
                        android:progressBackgroundTint="@color/progress_track"
                        android:progressTint="@color/progress_indicator" />

                    <!-- Progress Text -->
                    <TextView
                        android:id="@+id/heroProgressText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Page 45 of 120 (37%)"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

                <!-- Empty State for Hero Card -->
                <LinearLayout
                    android:id="@+id/heroEmptyLayout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📖"
                        android:textSize="48sp"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No document opened yet"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Click Browse Files above to choose a PDF from Storage or USB."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:layout_marginTop="6dp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- 2. Recent Books Section -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/sectionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Recent Books"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvBookCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 documents"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvRecentBooks"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:scrollbars="vertical"
                    android:nextFocusLeft="@+id/heroCard"
                    android:nextFocusUp="@+id/btnLibrary" />

                <!-- Empty state when no books -->
                <LinearLayout
                    android:id="@+id/recentEmptyLayout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No PDF files in Recent list."
                        android:textColor="@color/text_secondary"
                        android:textSize="15sp" />

                    <Button
                        android:id="@+id/btnScanStorage"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="🔍 Auto-Scan Device for PDFs"
                        android:textColor="@color/btn_focus_text_color"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="@drawable/focus_button_bg"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:focusable="true"
                        android:layout_marginTop="16dp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
