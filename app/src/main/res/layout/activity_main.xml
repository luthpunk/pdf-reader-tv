<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main"
    android:paddingStart="48dp"
    android:paddingEnd="48dp"
    android:paddingTop="28dp"
    android:paddingBottom="24dp">

    <!-- Top Bar: TV Reader Brand + Fixed Frosted Neon Pills -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <!-- Brand Title with Neon Dot -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TV Reader"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold"
                android:letterSpacing="0.02" />

            <View
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/focus_button_bg"
                android:backgroundTint="@color/neon_cyan" />
        </LinearLayout>

        <!-- Top Menu Pills: [Search], [Sort By], [Browse Files] (Fixed Size, No Scale) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSearch"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:text="🔍 Search"
                android:textColor="@color/btn_focus_text_color"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/focus_button_bg"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:focusable="true"
                android:nextFocusRight="@+id/btnSort"
                android:layout_marginEnd="12dp" />

            <Button
                android:id="@+id/btnSort"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:text="⇅ Sort: Date"
                android:textColor="@color/btn_focus_text_color"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/focus_button_bg"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:focusable="true"
                android:nextFocusLeft="@+id/btnSearch"
                android:nextFocusRight="@+id/btnBrowseFiles"
                android:layout_marginEnd="12dp" />

            <Button
                android:id="@+id/btnBrowseFiles"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:text="📂 Browse Files"
                android:textColor="@color/btn_focus_text_color"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/focus_button_bg"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:focusable="true"
                android:nextFocusLeft="@+id/btnSort" />
        </LinearLayout>
    </LinearLayout>

    <!-- Search Input Bar (Visible when Search button is active) -->
    <LinearLayout
        android:id="@+id/layoutSearchBar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/focus_button_bg"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginBottom="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔍"
            android:textSize="14sp"
            android:layout_marginEnd="12dp" />

        <EditText
            android:id="@+id/etSearchQuery"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:hint="Type book or document title..."
            android:textColorHint="@color/text_muted"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:background="@null"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLines="1" />

        <Button
            android:id="@+id/btnClearSearch"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="✕ Clear"
            android:textColor="@color/btn_focus_text_color"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/focus_button_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:focusable="true" />
    </LinearLayout>

    <!-- Main Content Swimlanes (Netflix / Apple TV Layout) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/mainScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ROW 1: CONTINUE READING -->
            <LinearLayout
                android:id="@+id/layoutContinueReading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CONTINUE READING"
                    android:textColor="@color/neon_cyan"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="12dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvContinueReading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:clipToPadding="false"
                    android:scrollbars="none" />
            </LinearLayout>

            <!-- ROW 2: ALL DOCUMENTS -->
            <LinearLayout
                android:id="@+id/layoutAllDocuments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ALL DOCUMENTS"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06" />

                    <TextView
                        android:id="@+id/tvTotalDocumentsCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="(0 files)"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvAllDocuments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:clipToPadding="false"
                    android:scrollbars="none" />

                <!-- Empty State when no PDFs are found -->
                <LinearLayout
                    android:id="@+id/layoutEmptyState"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📄"
                        android:textSize="36sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvEmptyMessage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No PDF documents found on this TV."
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Click Browse Files to locate PDFs or plug in a USB flash drive."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
